# GraphRAGX Environment Configuration Template

# Graph Database Settings (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphragx_secret
NEO4J_DATABASE=neo4j
# Set to true to run fully offline using in-memory NetworkX graph driver
USE_IN_MEMORY_GRAPH=true

# Vector Database Settings (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=graphragx_chunks
# Set to true to run fully offline using in-memory vector index
USE_IN_MEMORY_VECTOR=true

# LLM & Embedding Settings
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Ingestion & Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval & Fusion Defaults
DEFAULT_RETRIEVAL_STRATEGY=hybrid
TOP_K_CHUNKS=5
MAX_GRAPH_HOPS=2
MAX_GRAPH_FACTS=15
RRF_K=60
VECTOR_WEIGHT=0.5
GRAPH_WEIGHT=0.3
ENTITY_WEIGHT=0.2

# Logging & Debugging
LOG_LEVEL=INFO
DEBUG=true
